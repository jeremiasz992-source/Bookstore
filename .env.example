# Wzorzec pliku konfiguracyjnego środowiska kontenerowego.
# Skopiuj jako .env i uzupełnij własnymi wartościami.

POSTGRES_DB=BookStoreDb
POSTGRES_USER=bookstore
POSTGRES_PASSWORD=<haslo-do-bazy>

# Klucz podpisujący token JWT, minimum 32 znaki.
JWT_KEY=<klucz-podpisujacy-token>

# Dane serwera poczty. Bez nich aplikacja dziala, ale nie wysyła powiadomień.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=<adres-konta-smtp>
SMTP_PASSWORD=<haslo-aplikacji-smtp>
SMTP_FROM_EMAIL=<adres-nadawcy>
